# Connection string do banco Postgres (Neon)
DATABASE_URL=

# Senha única para entrar no painel (obrigatória — sem ela ninguém consegue acessar)
APP_PASSWORD=

# Opcional: protege /api/flows/process contra chamadas externas.
# Configure a mesma variável em Vercel Cron para que ele envie
# "Authorization: Bearer <valor>" automaticamente.
CRON_SECRET=
